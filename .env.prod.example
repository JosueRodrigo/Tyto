APP_NAME=Tyto
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tyto.example.com
APP_HOSTNAME=tyto.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tyto
DB_USERNAME=tyto
DB_PASSWORD=change-this-database-password
DB_CONNECT_TIMEOUT=5

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tyto
REVERB_APP_KEY=change-this-reverb-key
REVERB_APP_SECRET=change-this-reverb-secret
REVERB_HOST=ws.tyto.example.com
REVERB_PORT=443
REVERB_SCHEME=https

MAIL_MAILER=log
MAIL_FROM_ADDRESS=tyto@example.com
MAIL_FROM_NAME=Tyto

VITE_APP_NAME=Tyto
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}

ALLOW_REGISTRATION=false
TYTO_REPOSITORY=JosueRodrigo/Tyto
TYTO_UPDATE_CHECK=true
TYTO_INGEST_MAX_PAYLOAD_BYTES=1048576
TYTO_INGEST_MAX_RECORDS=500
TYTO_INGEST_RATE_LIMIT=600
TYTO_INGEST_IDEMPOTENCY_TTL=86400
TYTO_BACKUP_RETENTION_DAYS=14
